pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  namespace: jenkins
spec:
  containers:
    - name: jnlp
      image: jenkins/jnlp-agent:latest
      command: ['sleep', 'infinity']
    - name: dind
      image: docker:dind
      command: ['dockerd-entrypoint.sh', '--tls=false']
      securityContext:
        privileged: true
        seccompProfile:
          type: RuntimeDefault
      volumeMounts:
        - name: docker-sock
          mountPath: /var/run/docker.sock
    - name: docker-cli
      image: docker:cli
      command: ['cat']
      volumeMounts:
        - name: docker-sock
          mountPath: /var/run/docker.sock
      env:
        - name: DOCKER_HOST
          value: unix:///var/run/docker.sock
    - name: yq-tools
      image: mikefarah/yq:latest
      command: ['tail', '-f', '/dev/null']
      volumeMounts:
        - name: workspace
          mountPath: /workspace
    - name: kubectl
      image: bitnami/kubectl:latest
      command: ['tail', '-f', '/dev/null']
      volumeMounts:
        - name: workspace
          mountPath: /workspace
  volumes:
    - name: workspace
      emptyDir: {}
    - name: docker-sock
      emptyDir: {}
  restartPolicy: Never
"""
            id: 'pod'
        }
    }

environment {
  
    DOCKERHUB_CREDENTIALS_ID = 'docker_token_1'
    DOCKERHUB_REPO           = 'docker.io/archcra/st31'
    APP_NAME                 = 'st31'
    INFRA_PATH               = 'app-infra'  
    BASE_OVERLAYS_PATH       = 'overlays'   
    KUSTOMIZE_BASE_DIR       = 'base'       

  
    ENVIRONMENT              = '' 
    IMAGE_TAG                = ''
    TARGET_OVERLAY           = ''
}

    stages {
        stage('Checkout & Load Config') {
            steps {
                container('jnlp') {
                    checkout scm

                    script {

                        if (!fileExists('app/.ci-config.yaml')) {
                            error('Ошибка: файл app/.ci-config.yaml не найден!')
                        }

  
                        def config = readYaml file: 'app/.ci-config.yaml'


                        env.ENVIRONMENT      = config.environment ?: 'developer'  
                        env.IMAGE_TAG        = config.imageTag                 
                        env.TARGET_OVERLAY   = "${env.BASE_OVERLAYS_PATH}/${config.environment}"
                        env.KUSTOMIZE_FILE   = "${env.INFRA_PATH}/${env.KUSTOMIZE_BASE_DIR}/kustomization.yaml"


                        env.BRANCH_NAME      = sh(script: 'git rev-parse --abbrev-ref HEAD', returnStdout: true).trim()
                        env.COMMIT_SHA       = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()


                        env.FULL_IMAGE_NAME  = "${env.DOCKERHUB_REPO}:${env.BRANCH_NAME == 'main' ? env.COMMIT_SHA : "${env.BRANCH_NAME}-${env.COMMIT_SHA}"}"


                        if (!fileExists(env.KUSTOMIZE_FILE)) {
                            error("Ошибка: файл kustomization.yaml не найден по пути: ${env.KUSTOMIZE_FILE}")
                        }
                    }
                }
            }
        }
    }
        stage('Install Dependencies') {
            steps {
                container('jnlp') {
                    sh 'pip install -r app/requirements.txt'
                }
            }
        }

        stage('Run Tests') {
            steps {
                container('jnlp') {
                    sh 'pytest app/test/test_app.py --verbose'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                container('docker-cli') {
                    sh """
                    docker build -t ${env.FULL_IMAGE_NAME} app/
                    docker images
                    """
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                container('docker-cli') {
                    script {
                        withCredentials([usernamePassword(
                            credentialsId: env.DOCKERHUB_CREDENTIALS_ID,
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        )]) {
                            sh """
                            echo "${env.DOCKER_PASS}" | docker login -u "${env.DOCKER_USER}" --password-stdin
                            docker push ${env.FULL_IMAGE_NAME}
                            """
                        }
                    }
                }
            }
        }

        stage('Update Kustomize Manifests') {
            when {
                branch 'developer'
            }
            steps {
                container('yq-tools') {

                        if (!fileExists(env.KUSTOMIZE_FILE)) {
                            error("Kustomization file not found at: ${env.KUSTOMIZE_FILE}")
                        }


                        sh """
                        cd ${env.INFRA_PATH}
                        yq e '.images[0].newTag = "${env.IMAGE_TAG}"' -i ${env.TARGET_OVERLAY}/kustomization.yaml
                        echo "Updated kustomization.yaml with new image tag: ${env.IMAGE_TAG}"
                        """


                        withCredentials([usernamePassword(
                            credentialsId: 'github_token_1',
                            usernameVariable: 'GITHUB_USER',
                            passwordVariable: 'GITHUB_TOKEN'
                        )]) {
                            sh """
                            cd ${env.INFRA_PATH}
                            git config --global user.email "jenkins@ci.com"
                            git config --global user.name "Jenkins CI"
                            git add ${env.TARGET_OVERLAY}/kustomization.yaml
                            git commit -m "Update image tag to ${env.IMAGE_TAG} [skip ci]"
                            git push origin HEAD:${env.BRANCH_NAME}
                            """
                        }
                    }
                }
            }
        }
    

    post {
        always {
            container('docker-cli') {
                sh 'docker rmi ${env.FULL_IMAGE_NAME} || true'
            }
        }
    }

